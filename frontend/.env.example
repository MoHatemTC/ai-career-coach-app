# Where the API lives.
#
# Leave BLANK in development: `npm run dev` proxies /api to the backend (see
# vite.config.ts), so the browser talks to one origin and there is no CORS
# round trip. Set it for a build served from somewhere the proxy does not
# cover, e.g. https://api.example.com
VITE_API_BASE_URL=

# What the dev proxy forwards /api to. Only needed if the backend is not on
# 127.0.0.1:8000.
VITE_PROXY_TARGET=
