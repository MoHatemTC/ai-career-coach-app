# Copy this file to .env for local development.
# Do not commit .env.

APP_NAME=Sprints Career Coach
APP_ENV=development

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Public base URL of the app. Used to build "manage your alerts" links in
# digests, and as the fallback job link for postings with no source URL.
APP_BASE_URL=http://localhost:8501

# Frontend
FRONTEND_PORT=5173
# Streamlit settings UI
STREAMLIT_PORT=8501
# Where the Streamlit UI reaches the API.
API_BASE_URL=http://localhost:8000

# Database
# Start with SQLite for internship learning. PostgreSQL can be added later.
DATABASE_URL=sqlite:///./career_coach.db

# AI provider
AI_PROVIDER=litellm

LITELLM_BASE_URL=https://management.sprints.ai/litellm
# SECURITY: a real key was previously committed here in plain text and is in
# public git history. It must be treated as compromised and rotated — removing
# it from this file does NOT remove it from earlier commits.
LITELLM_API_KEY=
DEFAULT_MODEL=FW-Kimi-K2.6

# backend/services/llm_service.py reads this for CV parsing.
GEMINI_API_KEY=

# =============================================================================
# Notifications — daily top-3 job match digest
# =============================================================================

# Master switch for the daily scheduler. Default OFF so local dev and CI never
# send real messages. Set to true on the deployed instance only.
NOTIFICATIONS_SCHEDULER_ENABLED=false
# Minute of each hour the scheduler ticks. It checks every hour so each user
# is delivered at their own local send_hour.
NOTIFICATIONS_TICK_MINUTE=0

# --- WhatsApp via Postpeer (primary channel) ---------------------------------
# VERIFY THESE WITH ENG. SARA / THE POSTPEER DASHBOARD.
# See backend/features/notifications/providers/postpeer.py for what each does.
# Leaving POSTPEER_BASE_URL or POSTPEER_API_KEY empty disables WhatsApp and the
# dispatcher falls back to email automatically.
POSTPEER_BASE_URL=
POSTPEER_API_KEY=
POSTPEER_SEND_PATH=/v1/messages
POSTPEER_SENDER_ID=
# bearer | header | query
POSTPEER_AUTH_STYLE=bearer
POSTPEER_API_KEY_HEADER=Authorization
POSTPEER_FIELD_TO=to
POSTPEER_FIELD_BODY=text
POSTPEER_FIELD_FROM=from
POSTPEER_RESPONSE_ID_PATH=id
POSTPEER_TIMEOUT_SECONDS=20
# Set once a WhatsApp message template is approved. Empty = free-form text,
# which the WhatsApp Business Platform rejects for business-initiated messages
# outside the 24h window.
POSTPEER_TEMPLATE_NAME=
POSTPEER_TEMPLATE_LANGUAGE=en

# --- Email (fallback channel) ------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT_SECONDS=20
# With no EMAIL_HOST set, print the digest to the console instead of failing.
# Lets the pipeline be demoed end-to-end without SMTP credentials.
EMAIL_CONSOLE_FALLBACK=true
