# Copy this file to .env for local development.
# Do not commit .env.

APP_NAME=Sprints Career Coach
APP_ENV=development

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173

# Database
# Start with SQLite for internship learning. PostgreSQL can be added later.
DATABASE_URL=sqlite:///./career_coach.db

# Vector store (Qdrant) for job-posting embeddings.
# See docs/vector-store.md for the embedding contract.
# Strictly local for this phase — no hosted Qdrant, no API key.
#
# QDRANT_MODE=local  -> embedded, stores files at QDRANT_LOCAL_PATH, no Docker
#                       needed. NOTE: single process at a time — while the
#                       backend holds it, other scripts cannot open it.
# QDRANT_MODE=server -> connect to the docker-compose service; use this when
#                       more than one process needs the collection at once
#                       (start it with: docker compose up -d qdrant)
QDRANT_MODE=local
QDRANT_LOCAL_PATH=./qdrant_local_data
QDRANT_HOST=localhost
QDRANT_PORT=6333

# AI provider
#
# Which provider every LLM call goes to (backend/services/llm_client.py):
#   litellm -> the Sprints gateway below. THE DEFAULT, because the direct
#              Gemini keys are heavily rate limited: one pipeline run makes
#              three explanation calls plus a ranking call.
#   gemini  -> Gemini direct, via GEMINI_API_KEY / GEMINI_MODEL.
AI_PROVIDER=litellm

LITELLM_BASE_URL=https://learner-os.sprints.ai/litellm
# Paste the group key into .env, never here. This file is committed.
LITELLM_API_KEY=
# The model the gateway will actually serve THIS key. The group email says
# kimi-k2.5, but the team grant is models=['gemini/*'], so kimi-k2.5 comes back
# 403 "team not allowed to access model". The gemini/ prefix is part of the id
# and is required: the same model without it is refused. Verified against the
# live gateway. Key expires 2026-08-17.
DEFAULT_MODEL=gemini/gemini-pro-latest
# How long to wait on a single model call. The OpenAI SDK's own default is
# measured in minutes, so a wrong base URL hangs instead of failing usefully.
LLM_TIMEOUT_SECONDS=45

# Ceiling on a single completion. The gemini/* models are thinking models and
# their reasoning is billed against this same number, so it has to cover both
# the thinking and the answer. At 2000 the CV parser got JSON that stopped
# mid-string. Raise it if you see "hit the N-token ceiling" in the logs.
LLM_MAX_TOKENS=8000

# Origins the React frontend may call the API from, comma separated. Blank
# allows the Vite dev server on localhost:5173 and 127.0.0.1:5173, which is what
# `npm run dev` uses. Set this when serving the built frontend from anywhere
# else, or the browser blocks every request at the preflight.
CORS_ORIGINS=

# How long the Streamlit UI waits on POST /matching/pipeline. That request is
# four model calls in sequence (one ranking, three explanations), so a budget
# sized for one call reports a timeout while the backend is still working.
# Blank derives it from LLM_TIMEOUT_SECONDS, which is the sane default.
PIPELINE_TIMEOUT_SECONDS=

# Gemini, used only when AI_PROVIDER=gemini. Leave blank otherwise.
# Get a key from https://aistudio.google.com/apikey and paste it into .env.
GEMINI_API_KEY=

# Which model the Gemini path uses. Pick one your key can actually call: the
# code defaults to gemini-2.5-pro, which not every key has access to, and the
# failure is silent because call_gemini never raises.
GEMINI_MODEL=gemini-flash-latest

# Which model ranks the retrieved jobs. Applies to whichever provider
# AI_PROVIDER selects, so the value has to be one THAT provider serves: a
# gemini-* id here while AI_PROVIDER=litellm asks the gateway for a model it
# does not have. Leave it blank to use the provider's own default
# (DEFAULT_MODEL on the gateway, GEMINI_MODEL on Gemini), which is what you
# want unless ranking specifically needs a different model from everything else.
RANKING_MODEL=

# Confidence floor for the semantic skill-gap matcher, 0.0-1.0
# (backend/services/skill_gap.py). Values outside the range are ignored.
SEMANTIC_MATCH_THRESHOLD=0.75

# How long a Wuzzuf scrape stays cached before it is refetched
# (backend/services/ingestion.py). 0 always refetches. Without an expiry the
# job pool can never grow, since the scraper would never contact the site again.
WUZZUF_CACHE_TTL_SECONDS=21600

# ---------------------------------------------------------------------------
# Notifications — the daily top-3 job match digest
# ---------------------------------------------------------------------------
# See docs/notifications.md. Nothing below is required to run the app: with no
# credentials set, the digest prints to the API console instead of sending, so
# the whole pipeline can be demoed end to end.

# Where the app is reachable, used for the "manage your alerts" link in the
# message footer and the List-Unsubscribe header. Blank omits both.
APP_BASE_URL=http://localhost:5173

# The hourly tick that delivers digests. OFF BY DEFAULT, deliberately: with it
# on, every developer running the API locally and every test that imports
# backend.main would start sending real messages to real people.
NOTIFICATIONS_SCHEDULER_ENABLED=false
# Which minute past the hour it fires. Only matters if you are running more
# than one instance and want to stagger them.
NOTIFICATIONS_TICK_MINUTE=0

# --- WhatsApp via Postpeer (primary channel) -------------------------------
# VERIFY THESE AGAINST THE POSTPEER DASHBOARD BEFORE ENABLING.
# See backend/features/notifications/providers/postpeer.py for what each does
# and for the WhatsApp message-template constraint that may block this channel.
# Leaving POSTPEER_BASE_URL or POSTPEER_API_KEY empty disables WhatsApp, and
# the dispatcher falls back to email automatically.
POSTPEER_BASE_URL=
POSTPEER_API_KEY=
POSTPEER_SEND_PATH=/v1/messages
POSTPEER_SENDER_ID=
# bearer -> "Authorization: Bearer <key>"; header -> a custom header named by
# POSTPEER_API_KEY_HEADER; query -> ?api_key=<key>
POSTPEER_AUTH_STYLE=bearer
POSTPEER_API_KEY_HEADER=Authorization
POSTPEER_FIELD_TO=to
POSTPEER_FIELD_BODY=text
POSTPEER_FIELD_FROM=from
# Dotted path to the message id in the send response, e.g. "messages.0.id".
POSTPEER_RESPONSE_ID_PATH=id
POSTPEER_TIMEOUT_SECONDS=20
# Set once a WhatsApp message template is approved. Empty means free-form text,
# which the WhatsApp Business Platform rejects for business-initiated messages
# outside the 24-hour service window — which a daily digest always is.
POSTPEER_TEMPLATE_NAME=
POSTPEER_TEMPLATE_LANGUAGE=en

# --- Email (fallback channel) ----------------------------------------------
# Leave EMAIL_HOST blank for local development: with EMAIL_CONSOLE_FALLBACK on,
# the digest is printed to the API console instead of sent.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT_SECONDS=20
EMAIL_CONSOLE_FALLBACK=true
