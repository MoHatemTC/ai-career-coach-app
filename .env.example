# Copy this file to .env for local development.
# Do not commit .env.

APP_NAME=Sprints Career Coach
APP_ENV=development

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173

# Database
# Start with SQLite for internship learning. PostgreSQL can be added later.
DATABASE_URL=sqlite:///./career_coach.db

# AI provider
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: model used by backend/services/gemini_matcher.py for the
# semantic skill-matching pass. Defaults to gemini-2.5-pro if unset.
GEMINI_MODEL=gemini-2.5-pro

# Optional: confidence (0.0-1.0) at/above which a semantic match is
# treated as fully covering a required skill. Used by
# backend/services/skill_gap.py. Defaults to 0.75 if unset, and safely
# falls back to 0.75 (with a logged warning) if set to a non-numeric
# value or a value outside the 0.0-1.0 range.
SEMANTIC_MATCH_THRESHOLD=0.75

# Email notifications, optional for later tasks
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
