# Copy this file to .env for local development.
# Do not commit .env.

APP_NAME=Sprints Career Coach
APP_ENV=development

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173

# Database
# Start with SQLite for internship learning. PostgreSQL can be added later.
DATABASE_URL=sqlite:///./career_coach.db

# Vector store (Qdrant) for job-posting embeddings.
# See docs/vector-store.md for the embedding contract.
# Strictly local for this phase — no hosted Qdrant, no API key.
#
# QDRANT_MODE=local  -> embedded, stores files at QDRANT_LOCAL_PATH, no Docker
#                       needed. NOTE: single process at a time — while the
#                       backend holds it, other scripts cannot open it.
# QDRANT_MODE=server -> connect to the docker-compose service; use this when
#                       more than one process needs the collection at once
#                       (start it with: docker compose up -d qdrant)
QDRANT_MODE=local
QDRANT_LOCAL_PATH=./qdrant_local_data
QDRANT_HOST=localhost
QDRANT_PORT=6333

# AI provider
#
# Gemini. Required — without it CV parsing (backend/services/llm_service.py,
# step 1 of the whole flow) and the ranking lane both fail at call time, not at
# startup, so the app looks fine until you actually use it. Get a key from
# https://aistudio.google.com/apikey and paste it into your .env (never here).
GEMINI_API_KEY=

# Which model ranks the retrieved jobs (backend/features/ranking/reranker.py).
RANKING_MODEL=gemini-flash-latest

AI_PROVIDER=litellm

LITELLM_BASE_URL=https://management.sprints.ai/litellm
LITELLM_API_KEY=sk-VpojJfHKcpYXT6pD5KlCSw
DEFAULT_MODEL=FW-Kimi-K2.6
# Email notifications, optional for later tasks
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
