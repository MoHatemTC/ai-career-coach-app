  "paths": {
    "/matching/rank-jobs": {
      "post": {
        "tags": [
          "Matching",
          "Matching"
        ],
        "summary": "Rank Jobs For Profile",
        "operationId": "rank_jobs_for_profile_matching_rank_jobs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RankedJobResponse"
                  },
                  "type": "array",
                  "title": "Response Rank Jobs For Profile Matching Rank Jobs Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/matching/pipeline": {
      "post": {
        "tags": [
          "Matching",
          "Matching"
        ],
        "summary": "Run Pipeline",
        "description": "Retrieve candidate jobs, re-rank them, and explain each one.\n\nAll three stages of the matching chain: Qdrant retrieval, LLM re-ranking,\nthen the Match Explanation Agent.\n\nRetrieval itself reads Qdrant rather than SQL, but the session is needed by\nthe explanation stage, which joins each ranked posting back from SQLite on\n`job_id` to recover the skills the Qdrant payload does not carry.",
        "operationId": "run_pipeline_matching_pipeline_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PipelineRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelineResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/conversation": {
      "post": {
        "tags": [
          "Conversation"
        ],
        "summary": "Converse",
        "description": "Reply to a chat message, possibly editing the profile or starting a run.\n\nNever raises for \"the model misbehaved\" reasons: the service degrades to a\ndeterministic reply that still routes a request for matches correctly, so a\nmissing key or an overloaded model cannot take the chat down.",
        "operationId": "converse_conversation_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConversationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
