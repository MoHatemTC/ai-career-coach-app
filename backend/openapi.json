              {
                "type": "null"
              }
            ],
            "title": "Experience Level"
          }
        },
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "Profile",
        "description": "Minimal profile contract consumed by the skill-gap analyzer.\n\nAttributes:\n    user_id: Identifier of the profile owner.\n    skills: Raw skill strings as captured from CV/profile intake\n        (un-normalized; the skill-gap lane normalizes them via\n        `backend.services.skill_taxonomy`).\n    target_role: The role the user is targeting (e.g. \"Data Analyst\").\n        Matches PRD 7.1 \"Capture target roles...\".\n    experience_level: Free-text experience level (e.g. \"fresh graduate\",\n        \"junior\"), matches PRD persona definitions (Section 4)."
      },
