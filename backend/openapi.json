        "title": "PipelineRequest",
        "description": "The UI posts the profile it holds, which is the CV parser's output after\nthe user has edited it \u2014 a free-form dict, not a validated `Profile`. It is\ntyped loosely on purpose: forcing the UI to satisfy `Profile` (user_id,\nexperience_years, salary_expectation, ...) would mean inventing values the\nparser never produced."
      },
      "PipelineResponse": {
        "properties": {
          "ranked": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Ranked"
          }
        },
